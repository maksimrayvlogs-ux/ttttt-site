# одеялко — статический сайт + лёгкий PHP mock-API (REG.RU / Apache)
AddDefaultCharset UTF-8
DirectoryIndex index.html
Options -Indexes

<IfModule mod_rewrite.c>
RewriteEngine On

# www.одеялко.shop -> одеялко.shop
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# HTTP -> HTTPS (если SSL ещё не выпущен, временно закомментируйте следующие 3 строки)
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# ---- mock-API (демо-режим; реальные заказы не создаются) ----
RewriteRule ^procces/?$ api/procces.php [L,QSA]
RewriteRule ^storeapi/api/getproductslist/?$ api/storeapi.php?fn=list [L,QSA]
RewriteRule ^storeapi/api/getfilters/?$ api/storeapi.php?fn=filters [L,QSA]
RewriteRule ^storeapi/api/getproductsbyuid/?$ api/storeapi.php?fn=byuid [L,QSA]
RewriteRule ^storeapi/api/discounts/v1/getactive/?$ api/storeapi.php?fn=discounts [L,QSA]
RewriteRule ^cart-api/?$ api/cartapi.php [L,QSA]
RewriteRule ^geoserv/api/(city|address|house)/?$ api/geoserv.php?kind=$1 [L,QSA]
RewriteRule ^tilda/ api/noop.php [L]
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/jpeg "access plus 30 days"
ExpiresByType image/png "access plus 30 days"
ExpiresByType image/svg+xml "access plus 30 days"
ExpiresByType text/css "access plus 7 days"
ExpiresByType application/javascript "access plus 7 days"
ExpiresByType font/woff2 "access plus 365 days"
</IfModule>
