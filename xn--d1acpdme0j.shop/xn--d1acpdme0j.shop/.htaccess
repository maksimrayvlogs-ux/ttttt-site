# одеялко — статический сайт + лёгкий PHP mock-API + приём заказов (REG.RU / Apache)
AddDefaultCharset UTF-8
DirectoryIndex index.html
Options -Indexes

<IfModule mod_rewrite.c>
RewriteEngine On

# www.одеялко.shop -> одеялко.shop
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# HTTP -> HTTPS (сертификат управляется в панели REG.RU)
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# ---- API витрин/подсказок (демо-данные) и приёма заказов ----
RewriteRule ^procces/?$ api/procces.php [L,QSA]
RewriteRule ^storeapi/api/getproductslist/?$ api/storeapi.php?fn=list [L,QSA]
RewriteRule ^storeapi/api/getfilters/?$ api/storeapi.php?fn=filters [L,QSA]
RewriteRule ^storeapi/api/getproductsbyuid/?$ api/storeapi.php?fn=byuid [L,QSA]
RewriteRule ^storeapi/api/discounts/v1/getactive/?$ api/storeapi.php?fn=discounts [L,QSA]
RewriteRule ^cart-api/?$ api/cartapi.php [L,QSA]
RewriteRule ^geoserv/api/([a-z-]+)/?$ api/geoserv.php?kind=$1 [L,QSA]
RewriteRule ^tilda/ api/noop.php [L]
</IfModule>

# Секреты Telegram нельзя отдавать как обычные файлы.
<FilesMatch "^(telegram-config\.php|\.telegram-chat-id|telegram-setup(?: \(1\))?\.php|procces \(1\)\.php)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/jpeg "access plus 30 days"
ExpiresByType image/png "access plus 30 days"
ExpiresByType image/svg+xml "access plus 30 days"
ExpiresByType text/css "access plus 7 days"
ExpiresByType application/javascript "access plus 7 days"
ExpiresByType font/woff2 "access plus 365 days"
</IfModule>
